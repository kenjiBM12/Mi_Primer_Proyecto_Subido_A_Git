<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: white"
      stylesheets="@style.css" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.project_final.controller.HabitacionFormController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
    </padding>
    <children>
        <Label fx:id="lblTitulo" text="Datos de la habitacion" textFill="#014074">
            <font><Font name="System Bold" size="18.0"/></font>
        </Label>
        <Separator prefWidth="200.0"/>
        <GridPane hgap="10.0" vgap="15.0">
            <columnConstraints>
              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
              <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <!-- CORREGIDO: faltaba esta sexta fila. Habia 5 RowConstraints pero el
     formulario tiene 6 filas (Numero, NumeroPiso, NumeroHabitacion,
     Precio, Estado, Tipo). Agregala debajo de las otras 5. -->
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label text="Numero"/>
                <TextField fx:id="txtNumero" GridPane.columnIndex="1"/>
                <Label text="NumeroPiso" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNumeroPiso" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="NumeroHabitacion" GridPane.rowIndex="2"/>
                <TextField fx:id="txtNumeroHabitacion" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Precio" GridPane.rowIndex="3"/>
                <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Estado" GridPane.rowIndex="4"/>
                <TextField fx:id="txtEstado" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Label text="Tipo" GridPane.rowIndex="5"/>
                <ComboBox fx:id="cbTipo" maxWidth="-Infinity" GridPane.columnIndex="1"
                          GridPane.rowIndex="5"/>
            </children>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel"
                        prefHeight="31.0" prefWidth="100.0" styleClass="button-action-delete"
                  text="Cancelar"/>
                <Button mnemonicParsing="false" onAction="#handleSave"
                        prefHeight="31.0" prefWidth="100.0" styleClass="button-action-edit"
                        text="Guardar"/>
            </children>
            <VBox.margin><Insets top="10.0"/></VBox.margin>
        </HBox>


    </children>

</VBox>
